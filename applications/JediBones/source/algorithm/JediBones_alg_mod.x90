!>@brief Empty Jedi-bones algorithm.
module JediBones_alg_mod

  use log_mod,            only: log_event, log_level_info

  use driver_modeldb_mod, only: modeldb_type
  use field_mod,          only: field_type

  implicit none

  private

  public :: JediBones_alg

contains

  !> @details An algorithm for developing applications
  !> @param[in]    modeldb  Application state object
  !> @param[inout] field_1  A prognostic field object
  subroutine JediBones_alg(modeldb, field_1)

    implicit none

    type(modeldb_type), intent(in) :: modeldb

    ! Prognostic fields
    type(field_type), intent(inout) :: field_1

    call log_event( "JediBones: Running empty algorithm", log_level_info )

  end subroutine JediBones_alg

end module JediBones_alg_mod
