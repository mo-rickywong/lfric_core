!--------------------------------------------------------------------
! Example namelist for Cubed-Sphere mesh generation + Eave Meshes
!--------------------------------------------------------------------
! These namelists will result in the cubedsphere mesh generator
! producing an output file with a single cubedsphere mesh topology
! identified the <mesh_names> variable.
!
! Additionall 6 eaves meshes (1 per cubedsphere-panel) based on the
! specified parent 'C24' mesh as parent will also be included in the 
! output file
!
!===================================================================
&mesh
  mesh_file_prefix  = 'cs_eaves'
  geometry       = 'spherical'
  topology       = 'periodic'
  n_meshes       = 1
  mesh_names     = 'C24'
  partition_mesh = .false.
  coord_sys      = 'll'
  rotate_mesh    = .false.
/

&cubedsphere_mesh
  edge_cells          = 24
  smooth_passes       = 0
  equatorial_latitude = 0.0
  create_eave_mesh    = .true.
/

&partitions
  panel_decomposition = 'auto'
  panel_xproc         = 1
  panel_yproc         = 1
  max_stencil_depth   = 1
  n_partitions        = 6
  partition_range     = 0, 5
/

&rotation
  rotation_target    = "null_island"
  target_null_island = 0.0, 45.0
  target_north_pole  = 0.0, 45.0
/

&eave_mesh
  parent_mesh = 'C24'
  eave_depth  = 3
/
